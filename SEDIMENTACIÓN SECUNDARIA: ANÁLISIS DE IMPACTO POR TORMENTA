# 1. PREPARACIÓN DE ENTORNO
# ------------------------------------------------------------------------------
if (!require("pacman")) install.packages("pacman")
pacman::p_load(ggplot2, dplyr, showtext, patchwork)

# Configuración de tipografia 
font_add_google("Inter", "modern_sans")
showtext_auto()

# 2. PARÁMETROS OPERATIVOS (ESCENARIO CARGA ALTA)
# ------------------------------------------------------------------------------
# Escenario de tormenta: el flujo sube a 25,000 m³/d, la succión baja a
# 4,000 m³/d y la sedimentabilidad se degrada (k = 0.25) mientras la biomasa
# sube a 5.5 kg/m³. Son los mismos valores del escenario "Tormenta" del
# archivo "DINÁMICA DE ESTABILIDAD EN 4 ESTADOS CRÍTICOS" (mismo
# sedimentador de 800 m²), para que ambos análisis sean comparables.
A  <- 800        # Área superficial del sedimentador (m2)
Q  <- 25000      # Caudal de entrada durante la tormenta (m3/d)
Qr <- 4000       # Caudal de recirculación de lodos (m3/d)
X  <- 5.5        # Concentración de sólidos en el licor mezcla (kg/m3)
v0 <- 140        # Velocidad máxima de sedimentación teórica (m/d)
k  <- 0.25       # Coeficiente de compactación del lodo (m3/kg)

# Cálculos (usar esta nomenclatura para que los graficos funcionen)
OR  <- Q / A                    # Tasa de desbordamiento (m/d)
u   <- Qr / A                   # Velocidad del flujo inferior o succión (m/d)
Gi  <- OR * X                   # Flujo de sólidos hacia el efluente (kg/m2-d)
Gt  <- (Q + Qr) * X / A         # Flujo total de sólidos aplicados (kg/m2-d)
Xu  <- Gt / u                   # Concentración de lodo en el fondo (kg/m3)

# Mostrar resultados en consola
cat("--- RESULTADOS DEL ESCENARIO DE TORMENTA ---\n")
cat(sprintf("Tasa de desbordamiento (Overflow): %.2f m/d\n", OR))
cat(sprintf("Velocidad de succión (Underflow): %.2f m/d\n", u))
cat(sprintf("Flujo de sólidos en el punto de estado: %.2f kg/m2-d\n", Gi))
cat(sprintf("Flujo total de sólidos aplicados: %.2f kg/m2-d\n", Gt))
cat(sprintf("Concentración de lodo espesado (Fondo): %.2f kg/m3\n", Xu))

# Dataframe para la curva de flujo gravitatorio
# El rango llega a 45 kg/m³ para que se vea completo el extremo de la línea
# de transporte (Xu = 39.9 kg/m³).
df_spa <- data.frame(Xb = seq(0, 45, length.out = 500)) %>%
  mutate(Gs = v0 * exp(-k * Xb) * Xb)

# 3. GRÁFICA P1: ANÁLISIS DE PUNTO DE ESTADO 
# ------------------------------------------------------------------------------
p1 <- ggplot(df_spa, aes(x = Xb, y = Gs)) +
  geom_area(fill = "#2980b9", alpha = 0.15) +
  geom_line(color = "#2c3e50", linewidth = 1.3) +
  # Línea de transporte (pendiente negativa -u que intercepta Gt en x=0)
  annotate("segment", x = 0, y = Gt, xend = Xu, yend = 0, color = "#e67e22", linewidth = 1.1) +
  # Línea de desbordamiento (pendiente OR)
  geom_abline(intercept = 0, slope = OR, linetype = "dashed", color = "#7f8c8d") +
  # Punto de estado (State Point)
  annotate("point", x = X, y = Gi, size = 4, shape = 21, fill = "#e74c3c", color = "white") +
  labs(
    title = "ANÁLISIS DE PUNTO DE ESTADO",
    subtitle = "DINÁMICA DE FLUJO DE SÓLIDOS Y LÍMITE DE TRANSPORTE",
    x = "CONCENTRACIÓN DE SÓLIDOS (KG/M³)",
    y = "FLUJO DE SÓLIDOS (KG/M²·D)"
  ) +
  theme_minimal(base_family = "modern_sans") +
  theme(
    plot.title = element_text(size = 15, face = "bold", color = "#2c3e50"),
    plot.subtitle = element_text(size = 10, color = "#7f8c8d", margin = margin(b = 15)),
    panel.background = element_rect(fill = "#f4faff", color = NA),
    panel.grid.major = element_line(color = "white"),
    axis.title = element_text(face = "bold", size = 9)
  )

# 4. GRÁFICA P2: ESQUEMA ESTRUCTURAL 
# ------------------------------------------------------------------------------
p2 <- ggplot() +
  # Estructura del sedimentador
  geom_path(aes(x = c(10, 10, 45, 55, 90, 90), 
                y = c(50, 15, 0, 0, 15, 50)), 
            color = "#34495e", linewidth = 1.2) +
  
  # Zonas internas
  geom_rect(aes(xmin = 10, xmax = 90, ymin = 28, ymax = 48), fill = "#3498db", alpha = 0.1) +
  geom_polygon(aes(x = c(10, 45, 55, 90, 90, 10), 
                   y = c(15, 0, 0, 15, 25, 25)), fill = "#34495e", alpha = 0.05) +
  
  # Flujos (Vectores)
  annotate("segment", x = 50, y = 60, xend = 50, yend = 45, arrow = arrow(length = unit(0.25, "cm")), linewidth = 1, color = "#2c3e50") +
  annotate("segment", x = 50, y = 0, xend = 50, yend = -12, arrow = arrow(length = unit(0.25, "cm")), linewidth = 1, color = "#e67e22") +
  annotate("segment", x = 90, y = 48, xend = 110, yend = 48, arrow = arrow(length = unit(0.25, "cm")), linewidth = 1, color = "#2980b9") +
  
  # Etiquetas 
  annotate("text", x = 50, y = 65, label = "ALIMENTACIÓN (Q + QR)", family = "modern_sans", fontface = "bold", size = 3.5) +
  annotate("text", x = 112, y = 52, label = "EFLUENTE CLARIFICADO", family = "modern_sans", color = "#2980b9", size = 3.5, hjust = 0.5) +
  annotate("text", x = 50, y = -18, label = "EXTRACCIÓN DE LODOS", family = "modern_sans", color = "#e67e22", size = 3.5) +
  annotate("text", x = 25, y = 20, label = "  MANTO DE LODOS", family = "modern_sans", size = 3, color = "#7f8c8d") +
  
  # Ajuste de límites 
  xlim(0, 140) + ylim(-25, 75) +
  coord_fixed() +
  theme_void() +
  labs(title = "ESQUEMA OPERATIVO DEL SEDIMENTADOR") +
  theme(
    plot.title = element_text(family = "modern_sans", size = 13, face = "bold", hjust = 0.5, color = "#2c3e50", margin = margin(t = 10, b = 10))
  )

# 5. RENDERIZADO
# ------------------------------------------------------------------------------
print(p1)
print(p2)

# 6. EXPORTAR LOS GRÁFICOS ------------------------------------------------
ggsave("tormenta_punto_de_estado.png", plot = p1, width = 10, height = 6, dpi = 300)
ggsave("tormenta_esquema.png", plot = p2, width = 10, height = 6, dpi = 300)

# 7. INTERPRETACIÓN ---------------------------------------------------------
# Gráfica P1 (punto de estado): eje x, concentración de sólidos (kg/m³);
# eje y, flujo de sólidos (kg/m²·d). La curva es el flujo gravitatorio
# Gs = v0 * X * exp(-k * X); la línea punteada es el desbordamiento
# (pendiente OR = 31.25 m/d); la línea naranja es el transporte hacia el
# fondo, de (0, Gt) a (Xu, 0); el punto rojo es el punto de estado
# (X = 5.5 kg/m³, Gi = 171.9 kg/m²·d).
# Con los datos del script: Gt = 199.4 kg/m²·d y Xu = 39.9 kg/m³. La línea
# de transporte queda por encima de la curva gravitatoria en gran parte del
# recorrido (hasta unos 81 kg/m²·d por encima): el sedimentador no puede
# evacuar los sólidos a esa velocidad, los sólidos se acumulan y se produce
# el vertido hacia el cuerpo receptor. La tormenta falla porque combina tres
# efectos: más caudal (OR = 31.25 m/d), menos succión (u = 5.0 m/d) y peor
# sedimentabilidad (k = 0.25).
# Gráfica P2 (esquema): muestra dónde ocurre cada flujo. La alimentación
# (Q + Qr) entra por el cilindro central, el efluente clarificado sale por
# los vertederos perimetrales y el lodo se extrae por el fondo. Durante la
# tormenta, el manto de lodos sube porque entra más sólido del que se
# extrae, hasta alcanzar los vertederos.

# 8. QUÉ APRENDIMOS ---------------------------------------------------------
# - Un sedimentador falla cuando la línea de transporte supera la curva
#   gravitatoria, no cuando el caudal sube sin más: aquí fallan a la vez el
#   caudal alto, la succión baja y el lodo degradado.
# - Xu = 39.9 kg/m³ es la señal numérica de la falla: una concentración de
#   lodo espesado así de alta no es operable en la práctica.
# - El punto de estado (5.5, 171.9) queda por debajo de la curva, así que
#   la falla no se ve en el punto de operación: se ve en el resto de la
#   línea de transporte, donde la curva cae por debajo de ella.
