# Material académico para estudiantes
# Serie: Biotecnología ambiental / Ingeniería - Análisis de gases
#
# Descripción: Monitoreo de gases en el aire de una planta de tratamiento
# de aguas residuales con detector multigás. Se midió la concentración
# de 5 gases en 3 momentos de la jornada y se comparó el promedio con
# el valor límite de exposición (VLE) de la NOM-010-STPS-2014. El
# porcentaje del límite se calcula a partir de las mediciones: si llega
# a 100%, la exposición está en el límite y hay que actuar.
#
# Referencia normativa: NOM-010-STPS-2014, "Agentes químicos
# contaminantes del ambiente laboral - Reconocimiento, evaluación y
# control" (DOF 24-10-2014), Apéndice I. VLE-PPT (promedio ponderado
# en tiempo, 8 h): amoniaco 25 ppm, sulfuro de hidrógeno 1 ppm,
# monóxido de carbono 25 ppm, dióxido de carbono 5000 ppm. VLE-CT
# (corto tiempo, 15 min): cloro 0.5 ppm. El cloro no tiene VLE-PPT en
# la norma, por eso sus mediciones son máximos de 15 minutos y se
# comparan con el VLE-CT.
# ==========================================================================


# 1. PREPARACIÓN DE ENTORNO
# ------------------------------------------------------------------------------
if (!require("pacman")) install.packages("pacman")
pacman::p_load(ggplot2, dplyr)

# 2. TABLA DE MEDICIONES
# ------------------------------------------------------------------------------
# Concentraciones medidas con detector multigás en la planta de
# tratamiento, en partes por millón (ppm). Tres momentos de la jornada:
# mañana (inicio del turno), mediodía y tarde (fin del turno).
mediciones <- data.frame(
  gas = rep(c("Amoniaco (NH3)", "Cloro (Cl2)", "Sulfuro de hidrógeno (H2S)",
              "Monóxido de carbono (CO)", "Dióxido de carbono (CO2)"), each = 3),
  momento = rep(c("Mañana", "Mediodía", "Tarde"), times = 5),
  concentracion_ppm = c(
    15, 18, 21,          # NH3
    0.2, 0.3, 0.4,       # Cl2 (máximos de 15 min)
    0.6, 0.8, 1.0,       # H2S
    18, 21, 24,          # CO
    2800, 3200, 3600     # CO2
  ),
  stringsAsFactors = FALSE
)

# Límites de la NOM-010-STPS-2014 (ver encabezado). Para el cloro, el
# límite es el VLE-CT porque la norma no le fija VLE-PPT.
limites <- data.frame(
  gas = c("Amoniaco (NH3)", "Cloro (Cl2)", "Sulfuro de hidrógeno (H2S)",
          "Monóxido de carbono (CO)", "Dióxido de carbono (CO2)"),
  limite_ppm = c(25, 0.5, 1, 25, 5000),
  tipo_limite = c("VLE-PPT", "VLE-CT", "VLE-PPT", "VLE-PPT", "VLE-PPT"),
  stringsAsFactors = FALSE
)

# 3. PROMEDIO DE LA JORNADA Y PORCENTAJE DEL LÍMITE
# ------------------------------------------------------------------------------
resumen <- mediciones %>%
  group_by(gas) %>%
  summarise(
    promedio_ppm = mean(concentracion_ppm),
    maximo_ppm = max(concentracion_ppm),
    .groups = "drop"
  ) %>%
  left_join(limites, by = "gas") %>%
  mutate(
    porcentaje_limite = 100 * promedio_ppm / limite_ppm,
    porcentaje_maximo = 100 * maximo_ppm / limite_ppm,
    cumple = promedio_ppm < limite_ppm
  )

cat("--- GASES: PROMEDIO DE LA JORNADA FRENTE AL VLE (NOM-010-STPS-2014) ---\n")
print(resumen)
cat(sprintf("\nGas más cercano al límite (promedio): %s, %.0f%% del VLE\n",
            resumen$gas[which.max(resumen$porcentaje_limite)],
            max(resumen$porcentaje_limite)))

# 4. GRÁFICA 1: PORCENTAJE DEL LÍMITE ALCANZADO POR CADA GAS
# ------------------------------------------------------------------------------
resumen_ord <- resumen %>% arrange(desc(porcentaje_limite))
resumen_ord$gas <- factor(resumen_ord$gas, levels = rev(resumen_ord$gas))

p1 <- ggplot(resumen_ord, aes(x = gas, y = porcentaje_limite, fill = porcentaje_limite)) +
  geom_col(width = 0.6) +
  geom_text(aes(label = sprintf("%.0f%%", porcentaje_limite)), hjust = -0.3,
            fontface = "bold", size = 4) +
  geom_hline(yintercept = 100, linetype = "dashed", color = "#c0392b", linewidth = 1) +
  annotate("text", x = 1, y = 106, label = "Límite NOM-010-STPS-2014 (100%)",
           hjust = 0, color = "#c0392b", fontface = "bold", size = 3.5) +
  scale_fill_gradient(low = "#27ae60", high = "#e67e22", name = "% del límite") +
  labs(
    title = "Exposición a gases: porcentaje del valor límite alcanzado",
    subtitle = "Promedio de la jornada frente al VLE de la NOM-010-STPS-2014",
    x = "Gas",
    y = "Porcentaje del valor límite (%)"
  ) +
  coord_flip() +
  ylim(0, 115) +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 13, face = "bold", color = "#2c3e50"),
    axis.title = element_text(face = "bold", size = 10)
  )

# 5. GRÁFICA 2: MEDICIONES DURANTE LA JORNADA FRENTE AL LÍMITE
# ------------------------------------------------------------------------------
mediciones$momento <- factor(mediciones$momento,
                             levels = c("Mañana", "Mediodía", "Tarde"))

p2 <- ggplot(mediciones, aes(x = momento, y = concentracion_ppm, group = gas)) +
  geom_line(color = "#2980b9", linewidth = 1.1) +
  geom_point(color = "#2980b9", size = 3) +
  geom_hline(data = limites, aes(yintercept = limite_ppm),
             linetype = "dashed", color = "#c0392b", linewidth = 1) +
  facet_wrap(~ gas, scales = "free_y") +
  labs(
    title = "Concentración de gases durante la jornada y su valor límite",
    subtitle = "Línea punteada roja: VLE de la NOM-010-STPS-2014 (para el cloro, VLE-CT)",
    x = "Momento de la jornada",
    y = "Concentración (ppm)"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 13, face = "bold", color = "#2c3e50"),
    axis.title = element_text(face = "bold", size = 10)
  )

# 6. RENDERIZADO
# ------------------------------------------------------------------------------
print(p1)
print(p2)

# 7. EXPORTAR LOS GRÁFICOS ------------------------------------------------
ggsave("gases_porcentaje_limite.png", plot = p1, width = 10, height = 6, dpi = 300)
ggsave("gases_mediciones.png", plot = p2, width = 10, height = 6, dpi = 300)

# 8. INTERPRETACIÓN ---------------------------------------------------------
# Gráfica 1 (porcentaje del límite): eje x, gas; eje y, porcentaje del
# valor límite (%, adimensional: es el cociente entre la concentración
# medida y el límite, multiplicado por 100). La línea punteada en 100%
# es el límite de la norma. Ningún gas rebasa el límite en promedio,
# pero dos están cerca: el monóxido de carbono llega a 84% del VLE-PPT
# (promedio de 21 ppm frente a un límite de 25 ppm) y el sulfuro de
# hidrógeno a 80% (promedio de 0.8 ppm frente a 1 ppm). El amoniaco
# llega a 72% (18 de 25 ppm), el dióxido de carbono a 64% (3200 de
# 5000 ppm) y el cloro a 60% del VLE-CT (promedio de los máximos de
# 15 minutos de 0.3 ppm frente a 0.5 ppm).
# Gráfica 2 (mediciones por momento): eje x, momento de la jornada;
# eje y, concentración en ppm; cada panel es un gas con su propia
# escala. En los 5 gases la concentración sube de la mañana a la tarde:
# el CO pasa de 18 a 24 ppm, el H2S de 0.6 a 1.0 ppm y el NH3 de 15 a
# 21 ppm. El máximo registrado de H2S en la tarde (1.0 ppm) es igual
# al VLE-PPT, y el máximo de CO (24 ppm) es 96% del límite: aunque los
# promedios cumplen, los picos de la tarde tocan el límite. La
# tendencia creciente durante el turno indica que la ventilación no
# alcanza a renovar el aire conforme avanza la jornada.

# 9. QUÉ APRENDIMOS ---------------------------------------------------------
# - La comparación se hace en porcentaje del límite, no en ppm: 0.8 ppm
#   de H2S es más grave que 3200 ppm de CO2, porque sus límites son
#   1 ppm y 5000 ppm.
# - El promedio de la jornada no basta: el H2S promedia 80% del límite
#   pero su medición de la tarde llega a 100%. Hay que mirar también el
#   máximo.
# - El cloro no tiene VLE-PPT en la NOM-010-STPS-2014: sus mediciones
#   son máximos de 15 minutos y se comparan con el VLE-CT de 0.5 ppm.
#   Cada gas se compara con el tipo de límite que le corresponde.
# - Una tendencia que sube durante el turno es una señal de ventilación
#   insuficiente, aunque ningún valor rebase el límite ese día.
