# Material académico para estudiantes
# Serie: Biotecnología ambiental / Ingeniería - Análisis de riesgo
#
# Descripción: Recorrido por un laboratorio de biotecnología ambiental
# y su planta piloto. Entramos por el laboratorio de análisis, seguimos
# por la planta de tratamiento y la planta piloto, pasamos por el
# laboratorio de extracciones y terminamos en el almacén de reactivos.
# En cada parada del recorrido anotamos el peligro que vemos y lo
# calificamos con una probabilidad (1 a 5) y una severidad (1 a 5)
# asignadas por el equipo de trabajo; el nivel de riesgo es el producto
# probabilidad x severidad. Al terminar el recorrido, la matriz ordena
# los peligros para decidir cuáles se atienden primero.
#
# Referencia: matriz de riesgo 5 x 5 de uso estándar en gestión de
# seguridad (por ejemplo, ISO 31000 para gestión del riesgo y la guía
# ISO 45001 para seguridad y salud en el trabajo). Las escalas de
# probabilidad y severidad y los cortes de nivel son los definidos por
# el equipo en este ejercicio: Bajo 1-4, Medio 5-9, Alto 10-16,
# Muy alto 17-25.
# ==========================================================================


# 1. PREPARACIÓN DE ENTORNO
# ------------------------------------------------------------------------------
if (!require("pacman")) install.packages("pacman")
pacman::p_load(ggplot2, dplyr)

# 2. PRIMERA PARADA: LOS PELIGROS QUE VAMOS ENCONTRANDO EN EL RECORRIDO
# ------------------------------------------------------------------------------
# Empezamos en el laboratorio de análisis, donde vemos el derrame de
# ácido sulfúrico; seguimos a la planta de tratamiento, con la fuga de
# cloro y los lodos con patógenos; en la planta piloto encontramos el
# contacto eléctrico en el bombeo, el piso mojado y el agitador sin
# guarda; en el laboratorio de extracciones, los vapores de solvente,
# y cerramos en el almacén de reactivos, con los solventes inflamables.
# Probabilidad (P): 1 rara vez, 2 poco probable, 3 posible, 4 probable,
# 5 casi seguro. Severidad (S): 1 leve, 2 menor, 3 moderada, 4 grave,
# 5 catastrófica. P y S son calificaciones del equipo de trabajo, en
# escala adimensional de 1 a 5.
peligros <- data.frame(
  peligro = c(
    "Derrame de ácido sulfúrico concentrado",
    "Fuga de cloro gas en cloración",
    "Contacto eléctrico en equipo de bombeo",
    "Caída por piso mojado en área de reactores",
    "Exposición a vapores de solvente sin extracción",
    "Incendio por solventes inflamables almacenados",
    "Atrapamiento en agitador de reactor",
    "Exposición a lodos con patógenos"
  ),
  area = c(
    "Laboratorio de análisis",
    "Planta de tratamiento",
    "Planta piloto",
    "Planta piloto",
    "Laboratorio de extracciones",
    "Almacén de reactivos",
    "Planta piloto",
    "Planta de tratamiento"
  ),
  probabilidad = c(2, 2, 1, 4, 3, 2, 1, 3),
  severidad = c(4, 5, 5, 2, 3, 5, 4, 4),
  stringsAsFactors = FALSE
)

# 3. EN CADA PARADA CALCULAMOS EL NIVEL DE RIESGO
# ------------------------------------------------------------------------------
# En cada parada del recorrido multiplicamos probabilidad por severidad:
# el número que sale dice qué tan urgente es atender ese peligro.
# Riesgo = probabilidad x severidad. Niveles: 1-4 Bajo, 5-9 Medio,
# 10-16 Alto, 17-25 Muy alto.
peligros <- peligros %>%
  mutate(
    riesgo = probabilidad * severidad,
    nivel = case_when(
      riesgo <= 4 ~ "Bajo",
      riesgo <= 9 ~ "Medio",
      riesgo <= 16 ~ "Alto",
      TRUE ~ "Muy alto"
    ),
    nivel = factor(nivel, levels = c("Bajo", "Medio", "Alto", "Muy alto"))
  )

cat("--- PELIGROS EVALUADOS ---\n")
print(peligros[, c("peligro", "probabilidad", "severidad", "riesgo", "nivel")])
cat(sprintf("\nRiesgo máximo: %d | Riesgo promedio: %.2f\n",
            max(peligros$riesgo), mean(peligros$riesgo)))
print(table(peligros$nivel))

# 4. PARADA EN LA SALA DE CONTROL: LA MATRIZ DE RIESGO 5 x 5
# ------------------------------------------------------------------------------
# Terminamos el recorrido en la sala de control y ponemos los 8
# peligros sobre la matriz: cada uno cae en su celda según su
# probabilidad y su severidad, y el color dice su nivel.
matriz <- expand.grid(probabilidad = 1:5, severidad = 1:5) %>%
  mutate(
    riesgo = probabilidad * severidad,
    nivel = case_when(
      riesgo <= 4 ~ "Bajo",
      riesgo <= 9 ~ "Medio",
      riesgo <= 16 ~ "Alto",
      TRUE ~ "Muy alto"
    ),
    nivel = factor(nivel, levels = c("Bajo", "Medio", "Alto", "Muy alto"))
  )

colores_nivel <- c("Bajo" = "#27ae60", "Medio" = "#f1c40f",
                   "Alto" = "#e67e22", "Muy alto" = "#c0392b")

p1 <- ggplot(matriz, aes(x = probabilidad, y = severidad, fill = nivel)) +
  geom_tile(color = "white", linewidth = 1) +
  geom_text(aes(label = riesgo), color = "white", fontface = "bold", size = 5) +
  geom_point(data = peligros, aes(x = probabilidad, y = severidad),
             shape = 21, size = 5, fill = "white", color = "#2c3e50", stroke = 1.5) +
  geom_text(data = peligros,
            aes(x = probabilidad, y = severidad, label = seq_len(nrow(peligros))),
            color = "#2c3e50", fontface = "bold", size = 3.5) +
  scale_fill_manual(values = colores_nivel) +
  scale_x_continuous(breaks = 1:5) +
  scale_y_continuous(breaks = 1:5) +
  labs(
    title = "Matriz de riesgo 5 x 5: peligros del laboratorio y la planta piloto",
    subtitle = "Los números en las celdas son el riesgo (probabilidad x severidad); los círculos numerados son los 8 peligros evaluados",
    x = "Probabilidad (escala adimensional de 1 a 5)",
    y = "Severidad (escala adimensional de 1 a 5)",
    fill = "Nivel de riesgo"
  ) +
  coord_fixed() +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 13, face = "bold", color = "#2c3e50"),
    axis.title = element_text(face = "bold", size = 10)
  )

# 5. LA LISTA DE PRIORIDADES AL TERMINAR EL RECORRIDO
# ------------------------------------------------------------------------------
# Con la matriz a la vista, ordenamos los peligros del más al menos
# riesgoso: esta es la lista con la que salimos de la sala de control.
peligros_ord <- peligros %>% arrange(desc(riesgo))
peligros_ord$peligro <- factor(peligros_ord$peligro, levels = rev(peligros_ord$peligro))

p2 <- ggplot(peligros_ord, aes(x = peligro, y = riesgo, fill = nivel)) +
  geom_col(width = 0.6) +
  geom_text(aes(label = riesgo), hjust = -0.3, fontface = "bold", size = 4) +
  geom_hline(yintercept = 10, linetype = "dashed", color = "#c0392b", linewidth = 1) +
  annotate("text", x = 1, y = 10.8, label = "A partir de 10: nivel Alto",
           hjust = 0, color = "#c0392b", fontface = "bold", size = 3.5) +
  scale_fill_manual(values = colores_nivel) +
  labs(
    title = "Nivel de riesgo por peligro (riesgo = probabilidad x severidad)",
    x = "Peligro",
    y = "Riesgo (adimensional, de 1 a 25)",
    fill = "Nivel de riesgo"
  ) +
  coord_flip() +
  ylim(0, max(peligros_ord$riesgo) + 2) +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 13, face = "bold", color = "#2c3e50"),
    axis.title = element_text(face = "bold", size = 10)
  )

# 6. MIRAMOS LOS DOS MAPAS DEL RECORRIDO
# ------------------------------------------------------------------------------
# Mostramos la matriz con los peligros ubicados y la lista ordenada:
# son los dos mapas con los que se decide qué se atiende primero.
print(p1)
print(p2)

# 7. EXPORTAR LOS GRÁFICOS ------------------------------------------------
ggsave("riesgo_matriz.png", plot = p1, width = 10, height = 6, dpi = 300)
ggsave("riesgo_puntajes.png", plot = p2, width = 10, height = 6, dpi = 300)

# 8. INTERPRETACIÓN ---------------------------------------------------------
# Al terminar el recorrido, los dos gráficos cuentan lo que vimos en
# la planta. Gráfica 1 (matriz 5 x 5): eje x, probabilidad (escala adimensional de
# 1 a 5); eje y, severidad (escala adimensional de 1 a 5). Cada celda
# muestra el riesgo, que es el producto de ambas. Los 8 peligros caen
# así: 1 en Bajo (atrapamiento en agitador, 1 x 4 = 4), 4 en Medio
# (derrame de ácido 2 x 4 = 8, caída por piso mojado 4 x 2 = 8, vapores
# de solvente 3 x 3 = 9, contacto eléctrico 1 x 5 = 5) y 3 en Alto
# (fuga de cloro 2 x 5 = 10, incendio de solventes 2 x 5 = 10, lodos con
# patógenos 3 x 4 = 12). Ningún peligro llega a Muy alto (17 a 25).
# Gráfica 2 (puntajes): eje x, peligro; eje y, riesgo (adimensional,
# de 1 a 25). El riesgo mayor es la exposición a lodos con patógenos
# (12), seguida de la fuga de cloro y el incendio de solventes (10 cada
# una). El riesgo promedio de los 8 peligros es 8.25. La línea punteada
# en 10 marca el inicio del nivel Alto: todo peligro en 10 o más se
# atiende primero. Nótese que el contacto eléctrico tiene severidad 5
# (la máxima) pero riesgo 5, porque su probabilidad es 1: la matriz
# combina ambas cosas y no se queda solo con lo grave.

# 9. QUÉ APRENDIMOS ---------------------------------------------------------
# - El riesgo no es solo "qué tan grave es": es probabilidad por
#   severidad. Un suceso catastrófico pero muy improbable puede tener
#   menos prioridad que uno moderado que ocurre seguido.
# - La matriz convierte opiniones del equipo (P y S en escala de 1 a 5)
#   en un orden de atención: primero los 3 peligros en Alto (lodos con
#   patógenos, fuga de cloro, incendio de solventes).
# - Los cortes de nivel (4, 9, 16) los define el equipo de trabajo; lo
#   importante es que se apliquen igual a todos los peligros y que
#   queden escritos antes de evaluar.
# - La matriz es una fotografía: hay que repetirla cuando cambie el
#   proceso, el equipo o después de un incidente.
# Terminamos el recorrido en la sala de control con la lista de
# prioridades en la mano: primero los 3 peligros en Alto, y después
# los 4 en Medio.
