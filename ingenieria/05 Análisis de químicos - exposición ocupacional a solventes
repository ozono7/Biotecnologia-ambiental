#
# Descripción: Monitoreo de la exposición ocupacional a 4 solventes en
# un laboratorio de extracciones. Se midió la concentración de cada
# solvente en 4 periodos de 2 horas durante la jornada de 8 horas y se
# calculó el promedio ponderado en el tiempo (TWA) de cada uno:
# TWA = suma(concentración x tiempo) / 8 horas. El TWA se compara con
# el valor límite de exposición promedio ponderado en tiempo (VLE-PPT)
# de la NOM-010-STPS-2014.
#
# Referencia normativa: NOM-010-STPS-2014, "Agentes químicos
# contaminantes del ambiente laboral - Reconocimiento, evaluación y
# control" (DOF 24-10-2014), Apéndice I. VLE-PPT (8 h): tolueno
# 20 ppm, xileno 100 ppm, acetona 500 ppm, metanol 200 ppm. El
# análisis químico cuantitativo (curvas de calibración, HPLC) se
# trabaja en el repositorio aprende-R; aquí el tema es el monitoreo
# de la exposición en el aire del laboratorio.
# ==========================================================================


# 1. PREPARACIÓN DE ENTORNO
# ------------------------------------------------------------------------------
if (!require("pacman")) install.packages("pacman")
pacman::p_load(ggplot2, dplyr)

# 2. TABLA DE MEDICIONES
# ------------------------------------------------------------------------------
# Concentraciones medidas en el aire del laboratorio de extracciones, en
# partes por millón (ppm), en 4 periodos de 2 horas que cubren la
# jornada completa de 8 horas.
mediciones <- data.frame(
  solvente = rep(c("Tolueno", "Xileno", "Acetona", "Metanol"), each = 4),
  periodo = rep(1:4, times = 4),
  horas_periodo = 2,
  concentracion_ppm = c(
    12, 18, 22, 10,       # Tolueno
    60, 85, 95, 70,       # Xileno
    280, 350, 420, 310,   # Acetona
    120, 160, 190, 140    # Metanol
  ),
  stringsAsFactors = FALSE
)

# Límites VLE-PPT de la NOM-010-STPS-2014 (ver encabezado).
limites <- data.frame(
  solvente = c("Tolueno", "Xileno", "Acetona", "Metanol"),
  limite_ppm = c(20, 100, 500, 200),
  stringsAsFactors = FALSE
)

# 3. CÁLCULO DEL TWA DE 8 HORAS Y DEL PORCENTAJE DEL LÍMITE
# ------------------------------------------------------------------------------
# TWA = suma(Ci x ti) / 8 h. Cada periodo dura 2 h, así que
# TWA = 2 x suma(Ci) / 8.
resumen <- mediciones %>%
  group_by(solvente) %>%
  summarise(
    twa_ppm = sum(concentracion_ppm * horas_periodo) / 8,
    maximo_periodo_ppm = max(concentracion_ppm),
    .groups = "drop"
  ) %>%
  left_join(limites, by = "solvente") %>%
  mutate(
    porcentaje_limite = 100 * twa_ppm / limite_ppm,
    cumple = twa_ppm < limite_ppm
  )

cat("--- SOLVENTES: TWA DE 8 H FRENTE AL VLE-PPT (NOM-010-STPS-2014) ---\n")
print(resumen)
cat(sprintf("\nSolvente más cercano al límite (TWA): %s, %.1f%% del VLE-PPT\n",
            resumen$solvente[which.max(resumen$porcentaje_limite)],
            max(resumen$porcentaje_limite)))

# 4. GRÁFICA 1: TWA COMO PORCENTAJE DEL LÍMITE
# ------------------------------------------------------------------------------
resumen_ord <- resumen %>% arrange(desc(porcentaje_limite))
resumen_ord$solvente <- factor(resumen_ord$solvente, levels = rev(resumen_ord$solvente))

p1 <- ggplot(resumen_ord, aes(x = solvente, y = porcentaje_limite, fill = porcentaje_limite)) +
  geom_col(width = 0.6) +
  geom_text(aes(label = sprintf("%.1f%%", porcentaje_limite)), hjust = -0.3,
            fontface = "bold", size = 4) +
  geom_hline(yintercept = 100, linetype = "dashed", color = "#c0392b", linewidth = 1) +
  annotate("text", x = 1, y = 106, label = "Límite NOM-010-STPS-2014 (100%)",
           hjust = 0, color = "#c0392b", fontface = "bold", size = 3.5) +
  scale_fill_gradient(low = "#27ae60", high = "#e67e22", name = "% del límite") +
  labs(
    title = "Exposición a solventes: TWA de 8 h como porcentaje del límite",
    subtitle = "Promedio ponderado en el tiempo frente al VLE-PPT de la NOM-010-STPS-2014",
    x = "Solvente",
    y = "Porcentaje del valor límite (%)"
  ) +
  coord_flip() +
  ylim(0, 115) +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 13, face = "bold", color = "#2c3e50"),
    axis.title = element_text(face = "bold", size = 10)
  )

# 5. GRÁFICA 2: CONCENTRACIÓN POR PERIODO FRENTE AL LÍMITE
# ------------------------------------------------------------------------------
p2 <- ggplot(mediciones, aes(x = periodo, y = concentracion_ppm, group = solvente)) +
  geom_line(color = "#2980b9", linewidth = 1.1) +
  geom_point(color = "#2980b9", size = 3) +
  geom_hline(data = limites, aes(yintercept = limite_ppm),
             linetype = "dashed", color = "#c0392b", linewidth = 1) +
  facet_wrap(~ solvente, scales = "free_y") +
  scale_x_continuous(breaks = 1:4) +
  labs(
    title = "Concentración de solventes por periodo de 2 h y su valor límite",
    subtitle = "Línea punteada roja: VLE-PPT de la NOM-010-STPS-2014",
    x = "Periodo de la jornada (cada uno de 2 horas)",
    y = "Concentración (ppm)"
  ) +
  theme_minimal() +
  theme(
    plot.title = element_text(size = 13, face = "bold", color = "#2c3e50"),
    axis.title = element_text(face = "bold", size = 10)
  )

# 6. RENDERIZADO
# ------------------------------------------------------------------------------
print(p1)
print(p2)

# 7. EXPORTAR LOS GRÁFICOS ------------------------------------------------
ggsave("quimicos_porcentaje_limite.png", plot = p1, width = 10, height = 6, dpi = 300)
ggsave("quimicos_mediciones.png", plot = p2, width = 10, height = 6, dpi = 300)

# 8. INTERPRETACIÓN ---------------------------------------------------------
# Gráfica 1 (TWA como porcentaje del límite): eje x, solvente; eje y,
# porcentaje del valor límite (%, adimensional: cociente entre el TWA
# y el límite, por 100). La línea punteada en 100% es el límite de la
# norma. Ningún solvente rebasa su VLE-PPT, pero todos están entre 68%
# y 77.5%: el tolueno y el xileno llegan a 77.5% (TWA de 15.5 ppm frente
# a un límite de 20 ppm, y TWA de 77.5 ppm frente a 100 ppm), el
# metanol a 76.2% (TWA de 152.5 ppm frente a 200 ppm) y la acetona a
# 68% (TWA de 340 ppm frente a 500 ppm). Los 4 solventes están en el
# mismo rango de porcentaje, así que ninguno destaca como el único
# problema: la exposición es generalizada en el laboratorio.
# Gráfica 2 (concentración por periodo): eje x, periodo de la jornada
# (4 periodos de 2 horas); eje y, concentración en ppm; cada panel es
# un solvente con su propia escala. En los 4 solventes el periodo 3
# (la mitad de la jornada, cuando se hacen más extracciones) es el más
# alto: el tolueno llega a 22 ppm (por arriba de su VLE-PPT de 20 ppm
# en ese periodo), el xileno a 95 ppm, la acetona a 420 ppm y el
# metanol a 190 ppm. Que un periodo rebase el límite no significa que
# el TWA lo rebase: el TWA pondera los 4 periodos y el periodo 4 baja
# (tolueno 10 ppm, xileno 70 ppm), pero el pico del periodo 3 marca
# cuándo hay que reforzar la ventilación.

# 9. QUÉ APRENDIMOS ---------------------------------------------------------
# - El TWA no es el promedio simple de las mediciones: es el promedio
#   ponderado por el tiempo de cada periodo. Con 4 periodos iguales de
#   2 h, TWA = 2 x suma(Ci) / 8.
# - La comparación se hace en porcentaje del límite: 340 ppm de acetona
#   es 68% de su límite, mientras que 15.5 ppm de tolueno es 77.5% del
#   suyo. El número grande no es el más grave.
# - Un periodo puede rebasar el VLE-PPT (tolueno 22 ppm en el periodo 3
#   frente a un límite de 20 ppm) y aun así el TWA cumplir: el límite
#   que se evalúa para la jornada es el TWA, pero el pico indica dónde
#   actuar.
# - Cuando los 4 solventes están en el mismo porcentaje del límite, el
#   problema es del área (ventilación general) y no de un solo producto.
