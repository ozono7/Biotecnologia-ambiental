# 1. PARÁMETROS DEL MODELO ------------------------------------------------
library(ggplot2)

tiempo_total <- 100
paso         <- 0.1
momentos     <- seq(0, tiempo_total, by = paso)

# Parámetros cinéticos
u_max      <- 0.2      # Tasa máxima de crecimiento específico (h^-1)
Ks         <- 30       # Constante de semisaturación (mg/L)
muerte     <- 0.05     # Tasa de decaimiento (h^-1)
eficiencia <- 0.6      # Rendimiento celular (Y)
dilucion   <- 0.1      # Tasa de dilución del sustrato (h^-1)

# 2. SIMULACIÓN NUMÉRICA --------------------------------------------------
# La biomasa se trata como retenida en el sistema (biopelícula): el balance
# de biomasa no incluye término de lavado por dilución. En un reactor de
# biopelícula la biomasa está adherida al soporte y no sale con el efluente
# a la tasa de dilución; el tiempo de retención de sólidos queda desacoplado
# del tiempo de retención hidráulico (Rittmann y McCarty, Environmental
# Biotechnology: Principles and Applications, 2001; Metcalf y Eddy,
# Wastewater Engineering, 5a ed., 2014). La pérdida de biomasa en este
# modelo simplificado es solo el decaimiento; en una biopelícula real la
# otra pérdida es el desprendimiento (detachment/sloughing), no el lavado
# hidráulico. Si el sistema fuera un quimiostato de mezcla completa con
# salida de biomasa, habría que restar la dilución en dB: dB <- (crecimiento - muerte - dilucion) * biomasa[i] * paso.
# Con el balance de biopelícula, el estado estacionario lo fija
# crecimiento = muerte, es decir S = Ks * muerte / (u_max - muerte) = 10 mg/L
# y X = 108 mg/L con entrada de 100 mg/L; con término de dilución serían
# S = 90 mg/L y X = 4 mg/L, que es el estado estacionario de un quimiostato.
n <- length(momentos)
sustrato <- numeric(n)
biomasa  <- numeric(n)

# Condiciones iniciales
sustrato[1] <- 15
biomasa[1]  <- 50

for (i in 1:(n - 1)) {
  # Cambio de carga orgánica en t = 30
  entrada <- ifelse(momentos[i] < 30, 100, 150)
  
  # Modelo 
  crecimiento <- (u_max * sustrato[i]) / (Ks + sustrato[i])
  
  # Balance de masa (Ecuaciones diferenciales)
  dS <- (dilucion * (entrada - sustrato[i]) - (crecimiento * biomasa[i] / eficiencia)) * paso
  dB <- (crecimiento - muerte) * biomasa[i] * paso
  
  sustrato[i+1] <- sustrato[i] + dS
  biomasa[i+1]  <- biomasa[i] + dB
}

# 3. VISUALIZACIÓN --------------------------------------------
df <- data.frame(Tiempo = momentos, Sustrato = sustrato, Biomasa = biomasa)

# Factor de escala para el eje secundario (Biomasa suele ser mayor)
mult_factor <- 5

grafico <- ggplot(df, aes(x = Tiempo)) +
  # Curva de Sustrato (Eje Principal)
  geom_line(aes(y = Sustrato, color = "Sustrato"), linewidth = 1.2) +

  # Curva de Biomasa (Escalada para el Eje secundario)
  geom_line(aes(y = Biomasa / mult_factor, color = "Biomasa"), linewidth = 1.2) +
  
  # Configuración de Ejes
  scale_y_continuous(
    name = "Sustrato (mg/L)",
    sec.axis = sec_axis(~.*mult_factor, name = "Biomasa (mg/L)")
  ) +
  
  # Delimitación técnica de fases
  geom_vline(xintercept = 30, linetype = "dashed", color = "grey50", alpha = 0.7) +
  annotate("text", x = 15, y = max(df$Sustrato) * 1.1, label = "Estado estacionario", size = 3) +
  annotate("text", x = 65, y = max(df$Sustrato) * 1.1, label = "Respuesta a transitorio", size = 3) +
  
  # Estética y colores
  scale_color_manual(values = c("Sustrato" = "#2C3E50", "Biomasa" = "#27AE60")) +
  labs(
    title = "Cinética de biopelícula: Balance de masa y crecimiento",
    subtitle = "Simulación con cambio de carga en t=30h",
    x = "Tiempo de operación (h)",
    color = "Variable"
  ) +
  
  # Refinamiento del Tema
  theme_bw() +
  theme(
    legend.position = "bottom",
    plot.title = element_text(face = "bold", size = 14),
    panel.grid.minor = element_blank(),
    axis.title.y.right = element_text(color = "#27AE60"),
    axis.title.y.left = element_text(color = "#2C3E50")
  )

print(grafico)

# 4. EXPORTAR EL GRÁFICO ---------------------------------------------------
ggsave("choque_de_carga.png", plot = grafico, width = 10, height = 6, dpi = 300)

# 5. INTERPRETACIÓN ---------------------------------------------------------
# El gráfico muestra la respuesta del sistema al choque de carga en t = 30 h.
# Eje x: tiempo de operación (h). Eje izquierdo: sustrato (mg/L). Eje derecho:
# biomasa (mg/L). La línea de biomasa se divide entre 5 solo para dibujarla en
# la misma escala; el eje derecho devuelve sus valores reales (mg/L).
# Con los parámetros del script, el sustrato sube al inicio hasta unos 21 mg/L
# y luego baja hacia unos 10 mg/L, mientras la biomasa crece de 50 mg/L hacia
# unos 108 mg/L antes del choque. Al subir la carga de entrada de 100 a
# 150 mg/L en t = 30 h, el sustrato apenas se mueve (sigue cerca de 10 mg/L)
# y la biomasa sube hasta unos 168 mg/L: el sistema absorbe el choque
# produciendo más biomasa en lugar de acumular sustrato.
# La línea vertical marca el momento del cambio de carga.

# 6. QUÉ APRENDIMOS ---------------------------------------------------------
# - Un choque de carga no siempre se ve como un pico de sustrato: si la
#   biomasa tiene capacidad de crecimiento, el sustrato se mantiene bajo y
#   el efecto aparece como más biomasa.
# - El estado estacionario lo fija la cinética (cuando el crecimiento iguala
#   al decaimiento), no la carga de entrada: por eso el sustrato se estabiliza
#   cerca del mismo valor antes y después del choque.
# - La integración de Euler con paso de 0.1 h es estable con estos parámetros
#   y el sustrato nunca toma valores negativos.
